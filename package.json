{
  "name": "tanstack-redesign",
  "version": "1.0.0",
  "description": "A modern, responsive digital business card for Stephen Frederick, Staff Engineer at Advanced Engineering Consultants.",
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "wrangler types && tsc --noEmit",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "db:setup": "wrangler d1 execute contact-site-db --local --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute contact-site-db --local --file=./db/seed.sql",
    "deploy": "wrangler deploy"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-router": "^1.170.25",
    "@tanstack/react-start": "^1.168.42",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.17.6",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.26",
      "nanoid": "3.3.18"
    }
  }
}
