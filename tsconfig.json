{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  "include": [
    "app",
    "vite.config.ts",
    "vitest.config.ts",
    "server.ts",
    "env.d.ts",
    "worker-configuration.d.ts"
  ]
}
