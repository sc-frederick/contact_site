{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "types": [
      "$app/types",
      "vite/client"
    ],
    "target": "ES2022"
  },
  "include": [
    "src",
    "vite.config.ts",
    "vitest.config.ts",
    "cloudflare.config.ts",
    "wrangler.config.ts",
    "tools/cloudflare-adapter.ts",
    ".cloudflare/types/index.d.ts"
  ],
  "exclude": [
    "src/service-worker"
  ]
}
