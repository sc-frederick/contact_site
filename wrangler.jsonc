{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "contact-site",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Custom entry (wraps @tanstack/react-start/server-entry) that enforces HTTPS
  // and adds security headers (CSP, HSTS, etc.) to every response.
  "main": "./server.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sfrederick.dev", "custom_domain": true },
    { "pattern": "www.sfrederick.dev", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "contact-site-db",
      "database_id": "f3fb4f29-7bd9-468d-a716-13da94ef2718"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  // Outbound email via Cloudflare Email Sending (enabled on the sfrederick.dev zone).
  // Sender and destination are constrained at the binding layer as well as being
  // fixed server-side values, preventing arbitrary-recipient email abuse.
  "send_email": [
    {
      "name": "SEND_EMAIL",
      "allowed_destination_addresses": ["sfred.mail@gmail.com"],
      "allowed_sender_addresses": ["contact@sfrederick.dev"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 0.1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Non-secret config. Change here, no code edit.
  // TURNSTILE_SITE_KEY is public (it ships to the browser) — this is the real sitekey
  // for the sfrederick.dev Turnstile widget. Local dev overrides it with a test key via
  // .dev.vars. The matching secret is NOT here; set it for prod with:
  //   wrangler secret put TURNSTILE_SECRET_KEY
  "vars": {
    "CONTACT_FROM_EMAIL": "contact@sfrederick.dev",
    "CONTACT_FROM_NAME": "sfrederick.dev contact form",
    "CONTACT_TO_EMAIL": "sfred.mail@gmail.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADnzUOVvXoGJmmGf"
  }
}
